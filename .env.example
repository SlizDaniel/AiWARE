# MAGAZYNIER — zmienne środowiskowe (skopiuj do .env)

# Klucz do chmurowego LLM (function calling). Bez klucza aplikacja używa parsera offline.
LLM_API_KEY=
LLM_MODE=llm
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
FAL_KEY=

# STT zgodne z Whisper (karta 04: push-to-talk) — np. Groq lub OpenAI.
# Bez klucza głos odpada JAWNIE: UI podświetla pole tekstowe jako fallback.
STT_API_KEY=
# Opcjonalne nadpisania (domyślnie: https://api.groq.com/openai/v1 + whisper-large-v3)
STT_BASE_URL=
STT_MODEL=

# Izolowane demo bez API (nadpisuje LLM_MODE, zachowuje zwykłą bazę).
DEMO_MODE=0
