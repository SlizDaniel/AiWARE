# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ MAGAZYNIER — zmienne środowiskowe                                        ║
# ║ Lokalnie: skopiuj ten plik do .env.local (nie trafia do gita).           ║
# ║ Vercel:   Project → Settings → Environment Variables (te same nazwy).    ║
# ║ Po zmianie NEXT_PUBLIC_* na Vercelu zrób Redeploy (są wbudowywane w build)║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# Na Vercelu WYMAGANE są 4 zmienne z sekcji 1–3. Reszta jest opcjonalna.
# Lokalnie wszystko jest opcjonalne: bez zmiennych aplikacja działa na lokalnej
# bazie (./data/pglite), bez logowania i z parserem komend offline.


# ── 1. Gemini — rozumienie komend, transkrypcja mowy, mapowanie kolumn ──────
# Klucz: https://aistudio.google.com/apikey → „Create API key”.
# Uwaga (Windows): zmienna systemowa GEMINI_API_KEY / GOOGLE_API_KEY ma
# pierwszeństwo przed tym plikiem — usuń starą, jeśli jest nieaktualna.
# Sprawdzenie klucza: npm run check:gemini
GEMINI_API_KEY=


# ── 2. Supabase: baza danych (Postgres) ─────────────────────────────────────
# Tu trafiają stany, historia, strefy, procedury, ustawienia i konta.
# Serwer aplikacji łączy się z Postgresem bezpośrednio (SQL + transakcje),
# dlatego potrzebuje connection stringa — klucze z sekcji 3 nie dają dostępu
# do tabel (RLS jest włączone).
#
# Skąd: Supabase → projekt → przycisk „Connect” (górny pasek) → „Connection string”
#       → „Transaction pooler” (port 6543 — działa z funkcjami serverless Vercela
#       i z IPv4; „Direct connection” nie działa na Vercelu w darmowym planie).
# W skopiowanym adresie zamień [YOUR-PASSWORD] na hasło bazy (ustawione przy
# tworzeniu projektu; reset: Project Settings → Database). Znaki specjalne
# w haśle zakoduj w URL (np. @ → %40).
#
# Jeśli podłączysz Supabase przez integrację Vercela (Vercel → Storage →
# Supabase), ustawi ona POSTGRES_URL — wtedy DATABASE_URL możesz pominąć.
#
# Puste lokalnie → baza PGlite w ./data/pglite.
# Puste na Vercelu → baza w pamięci, dane znikają (UI pokaże ostrzeżenie).
DATABASE_URL=
# Przykład: postgresql://postgres.abcdefghijklmnop:HASLO@aws-0-eu-central-1.pooler.supabase.com:6543/postgres


# ── 3. Supabase: logowanie (role pracownik / kierownik) ─────────────────────
# Skąd: Supabase → Project Settings → API Keys
#   NEXT_PUBLIC_SUPABASE_URL             → „Project URL” (https://<ref>.supabase.co)
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY → „Publishable key” (sb_publishable_…)
#                                          lub starszy „anon public” key
# Oba są publiczne z założenia (trafiają do przeglądarki). NIGDY nie wpisuj tu
# „secret” / „service_role” key.
# Pierwsze konto, które się zaloguje, zostaje kierownikiem.
# W Supabase → Authentication → URL Configuration dodaj Redirect URL:
#   http://localhost:3000/auth/callback  oraz  https://<twoja-domena>/auth/callback
# Puste lokalnie → aplikacja działa bez logowania (lokalny kierownik).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ── 4. Opcjonalne ────────────────────────────────────────────────────────────
# Inny model Gemini i osobny model do mowy. Domyślny gemini-3.5-flash-lite odpowiada w <1 s;
# gemini-3.8-flash jest dokładniejszy, ale komenda trwa 4–11 s.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_STT_MODEL=

# Tryb startowy agenta: llm | offline | mock. Potem kierownik zmienia go w Ustawieniach.
# LLM_MODE=llm

# Strefa czasowa znaczników czasu w historii (Vercel działa w UTC).
# APP_TIMEZONE=Europe/Warsaw

# Wyłącza logowanie mimo kluczy Supabase — każdy jest lokalnym kierownikiem.
# Tylko lokalnie lub na demo offline, nigdy na publicznym wdrożeniu!
# AUTH_DISABLED=1

# Rozpoznawanie mowy: Groq Whisper large-v3 (ZALECANE — dokładniejszy polski, <1 s,
# dostaje listę towarów/stref z bazy). Klucz: https://console.groq.com/keys
# Bez klucza transkrypcję robi Gemini. Błąd Groq → automatycznie Gemini.
# STT_API_KEY=
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3

# Demo offline: parser bez chmury, osobna baza z danymi próby.
# Na Vercelu ustaw też DEMO_DATABASE_URL (INNA baza niż DATABASE_URL).
# DEMO_MODE=1
# DEMO_DATABASE_URL=
